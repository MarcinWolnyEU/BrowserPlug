{
  "manifest_version": 3,
  "name": "BrowserPlug",
  "version": "1.0.0",
  "description": "Browser extension that exposes data and functions to MCP clients via WebSocket",
  "homepage_url": "https://github.com/MarcinWolnyEU/browserplug",
  "default_locale": "en",
  "minimum_chrome_version": "138",
  "icons": {
    "16": "icons/tile/icon-16.png",
    "32": "icons/tile/icon-32.png",
    "48": "icons/app/icon-48.png",
    "128": "icons/app/icon-128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "contextMenus",
    "webRequest",
    "webNavigation",
    "clipboardWrite",
    "scripting",
    "userScripts",
    "sidePanel",
    "offscreen",
    "proxy"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "BrowserPlug",
    "default_icon": {
      "16": "icons/toolbar/light/connecting/icon-16.png",
      "24": "icons/toolbar/light/connecting/icon-24.png",
      "32": "icons/toolbar/light/connecting/icon-32.png",
      "48": "icons/toolbar/light/connecting/icon-48.png",
      "64": "icons/toolbar/light/connecting/icon-64.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
