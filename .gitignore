# Logs — load-bearing: these contain absolute paths, usernames and tool-call
# arguments. *.log alone does NOT match a rotated browserplug-server.log.2, hence the second
# pattern.
*.log
*.log.*
logs/

# Temporary files
.tmp/
.temp/
/graft/
.playwright-mcp/

# Feedback material in root — feedback1/, feedback2/, ... AND feedback-template.html.
/feedback*

